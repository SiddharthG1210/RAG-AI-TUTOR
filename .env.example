# .env.example — a template for .env, which holds the real settings.
#
# Copy this file to .env and fill in the key:
#     copy .env.example .env        (PowerShell / cmd)
# .env is listed in .gitignore, so the real key never reaches GitHub.
# src/tutor/config.py (M1) reads these values with pydantic-settings.

# --- LLM provider ------------------------------------------------------------
# Every LLM call goes through the openai SDK. Groq offers an OpenAI-compatible
# API, so pointing the SDK at Groq only takes this base URL and a Groq key.
# Switching provider means changing these lines, not the code.
LLM_BASE_URL=https://api.groq.com/openai/v1

# Create a free key at https://console.groq.com/keys (first needed in the
# M1 concept "A rough first version in one file").
LLM_API_KEY=

# --- Models --------------------------------------------------------------------
# The smaller model writes questions; the larger one grades typed answers.
# Free-tier limits per model: https://console.groq.com/settings/limits
QUESTION_MODEL=openai/gpt-oss-20b
GRADER_MODEL=openai/gpt-oss-120b
